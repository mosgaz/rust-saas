# ─────────────────────────────────────────────────────────────────────────────
# 1. PostgreSQL (read by docker-compose.yml)
# ─────────────────────────────────────────────────────────────────────────────
# Used by the rust-saas-postgres-core service. docker-compose.yml substitutes
# these values via ${POSTGRES_USER:-postgres} and so on. When left unset, the
# defaults from the compose file are used. The application itself does not
# read these variables; it connects via DATABASE_URL below.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rust_saas

# ─────────────────────────────────────────────────────────────────────────────
# 2. DATABASE_URL (read by the application, the seed binary, and `cargo test`)
# ─────────────────────────────────────────────────────────────────────────────
# Connection string used by sqlx. The user in this URL must have the
# CREATE DATABASE privilege for `#[sqlx::test]` (the default postgres
# superuser from docker-compose.yml satisfies this).
DATABASE_URL=postgres://postgres:postgres@localhost:5430/rust_saas

# ─────────────────────────────────────────────────────────────────────────────
# 3. Authentication (JWT access + opaque refresh)
# ─────────────────────────────────────────────────────────────────────────────
# Secret used to sign access JWTs. Generate a strong random value for local
# development and production (see README, "Generating JWT_SECRET").
JWT_SECRET=replace-with-a-long-random-secret

# Access-token lifetime in minutes. Short-lived; the client refreshes via the
# opaque refresh token (Stage 2b).
ACCESS_TOKEN_TTL_MINUTES=15

# Refresh-token lifetime in days. Rotation resets the per-row expires_at, so a
# frequently used session can outlive this value; change only with intent.
REFRESH_TOKEN_TTL_DAYS=30

# ─────────────────────────────────────────────────────────────────────────────
# 4. Server binding
# ─────────────────────────────────────────────────────────────────────────────
# Address and port where the Axum/Leptos server listens. `cargo-leptos` uses
# [package.metadata.leptos] site-addr from examples/saas-leptos/Cargo.toml;
# BIND_ADDR overrides it when running without cargo-leptos.
BIND_ADDR=127.0.0.1:3395

# ─────────────────────────────────────────────────────────────────────────────
# 5. Logging
# ─────────────────────────────────────────────────────────────────────────────
# Log level for tracing_subscriber (env-filter). Examples:
#   info
#   debug
#   saas_leptos=debug,info
RUST_LOG=info