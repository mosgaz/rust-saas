# ─────────────────────────────────────────────────────────────────────────────
# 1. PostgreSQL (для docker-compose.yml)
# ─────────────────────────────────────────────────────────────────────────────
# Используется сервисом rust-saas-postgres-core. docker-compose.yml подставляет
# эти значения через ${POSTGRES_USER:-postgres} и т.д.
# Если оставить пустыми — подставятся значения по умолчанию из compose-файла.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rust_saas

# PostgreSQL connection string used by the application and seed command.
# For the default Docker Compose setup:
# ─────────────────────────────────────────────────────────────────────────────
# 2. DATABASE_URL — для sqlx-cli
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5430/rust_saas

# ── [jwt] ────────────────────────────────────────────────────────────────────
# Secret used to sign session JWTs.
# Generate a strong random value for local development and production.
JWT_SECRET=replace-with-a-long-random-secret

# Address and port where the Axum/Leptos server listens.
BIND_ADDR=127.0.0.1:3395

# ─────────────────────────────────────────────────────────────────────────────
# 3. Логирование
# ─────────────────────────────────────────────────────────────────────────────
# Уровень логирования через tracing_subscriber (env-filter).
# Примеры: info, debug, rust_lms_api=debug,rust_lms_server=info
RUST_LOG=info